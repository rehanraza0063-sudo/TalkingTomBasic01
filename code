        <button class="mic" onclick="listen()">🎤 Talk to Me</button>

    </div>

</div>

<script>

let happiness = 80;

const pet = document.getElementById("pet");
const speech = document.getElementById("speech");
const happinessText = document.getElementById("happiness");

function updateHappiness(value) {

    happiness += value;

    if (happiness > 100) happiness = 100;
    if (happiness < 0) happiness = 0;

    happinessText.innerText = happiness;
}

function showSpeech(text, speak=true) {

    speech.innerText = text;
    speech.classList.add("show");

    setTimeout(() => {
        speech.classList.remove("show");
    }, 4000);

    if (speak) {

        window.speechSynthesis.cancel();

        const voice = new SpeechSynthesisUtterance(text);

        voice.rate = 0.9;
        voice.pitch = 1.25;
        voice.volume = 1;

        voice.onstart = function() {
            pet.classList.add("talking");
        };

        voice.onend = function() {
            pet.classList.remove("talking");
        };

        window.speechSynthesis.speak(voice);
    }
}

function talkRandom() {

    const messages = [

        "Hello! How are you?",
        "I am your virtual pet!",
        "Let's play together!",
        "You are my best friend!",
        "Give me some food!",
        "I love talking with you!",
        "What are you doing?",
        "Hehehe!",
        "That was fun!",
        "Come on, let's play!"

    ];

    const message =
        messages[Math.floor(Math.random() * messages.length)];

    showSpeech(message);
}

function feed() {

    updateHappiness(5);

    pet.classList.add("love");

    showSpeech("Yummy! Thank you! 🍎");

    setTimeout(() => {
        pet.classList.remove("love");
    }, 800);
}

function play() {

    updateHappiness(8);

    pet.classList.add("jump");

    showSpeech("Yay! Let's play! 🎾");

    setTimeout(() => {
        pet.classList.remove("jump");
    }, 600);
}

function petAnimal() {

    updateHappiness(4);

    pet.classList.add("love");

    showSpeech("Awwww... I like that! ❤️");

    createHearts();

    setTimeout(() => {
        pet.classList.remove("love");
    }, 800);
}

function createHearts() {

    for(let i=0; i<5; i++) {

        const heart = document.createElement("div");

        heart.className = "hearts";
        heart.innerText = "❤️";

        heart.style.left =
            (45 + Math.random()*20) + "%";

        heart.style.top =
            (45 + Math.random()*10) + "%";

        document.body.appendChild(heart);

        setTimeout(() => {
            heart.remove();
        }, 1000);
    }
}

/* CLICK PET */

pet.addEventListener("click", function() {

    const reactions = [
        "Hey! That tickles! 😂",
        "Meow!",
        "Hehehe!",
        "Don't poke me!",
        "I like attention! ❤️"
    ];

    pet.classList.add("shake");

    showSpeech(
        reactions[Math.floor(Math.random()*reactions.length)]
    );

    setTimeout(() => {
        pet.classList.remove("shake");
    }, 500);

});

/* MICROPHONE */

function listen() {

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;

    if (!SpeechRecognition) {

        showSpeech(
            "Sorry, your browser doesn't support voice recognition."
        );

        return;
    }

    const recognition = new SpeechRecognition();

    recognition.lang = "en-IN";
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    showSpeech("I'm listening... 🎤", false);

    recognition.start();

    recognition.onresult = function(event) {

        const text =
            event.results[0][0].transcript;

        respondToUser(text);
    };

    recognition.onerror = function() {

        showSpeech(
            "I couldn't hear you. Try again! 🎤"
        );
    };
}

function respondToUser(text) {

    const lower = text.toLowerCase();

    let response;

    if (
        lower.includes("hello") ||
        lower.includes("hi") ||
        lower.includes("hey")
    ) {

        response = "Hello! Nice to meet you!";

    } else if (
        lower.includes("how are you")
    ) {

        response = "I'm feeling great!";

    } else if (
        lower.includes("your name")
    ) {

        response = "I'm your talking pet!";

    } else if (
        lower.includes("play")
    ) {

        response = "Yes! Let's play!";

        play();

        return;

    } else if (
        lower.includes("food") ||
        lower.includes("eat")
    ) {

        response = "Yummy! I want some food!";

        feed();

        return;

    } else if (
        lower.includes("love")
    ) {

        response = "Aww! I love you too! ❤️";

        petAnimal();

        return;

    } else if (
        lower.includes("bye")
    ) {

        response = "Bye! Come back soon!";

    } else {

        response =
            "You said: " + text + ". That's interesting!";
    }

    showSpeech(response);
}

/* START MESSAGE */

setTimeout(() => {

    showSpeech(
        "Hi! Click me or talk to me! 🐱"
    );

}, 800);

</script>

